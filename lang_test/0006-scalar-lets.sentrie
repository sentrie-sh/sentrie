namespace scalars
policy scalar_vals {
	let s = "hello"
	let i = 42
	let f = 3.1415
	let b = true
	let n = null
	let g = false
	let i_neg = -100
	let u = -3.14
  let d = "sss"+"ggg"
  let heredoc=<<<HHH
Hello, World!
This is a heredoc string.
HHH
  rule _corpus = { yield true }
  export decision of _corpus
}
