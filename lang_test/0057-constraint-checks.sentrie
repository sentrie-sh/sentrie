namespace constraints/checks
shape Temp { celsius: number @range(-10, -1) @not_in(-5, -6) }
shape Tag string @in("a", "b") @length(1)
shape Endpoint { primary: string @url() secondary: string @url("ftp") any: string @url("http", "https", "ftp") }

policy constraint_checks {
  fact t: number @min(-5) @gt(-0.5) @multiple_of(-3)
  fact words: list[string @in("x", "y") @not_in("z")]
  let a = -3 is number @min(-5)
  let b = "é" is string @length(1)
  let c = "http://localhost:8080/x" is string @url()
  let d = "ftp://example.com" is string @url("ftp")
  rule _corpus = { yield a and b and c and d }
  export decision of _corpus
}
