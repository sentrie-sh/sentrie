namespace rules1
policy simple_rule {
	fact age: number
	rule isAdult = { yield age >= 18 }
	rule isMinor = { yield age < 18 }
	rule isSenior = { yield age >= 65 }  rule _corpus = { yield true }
  export decision of _corpus
}
