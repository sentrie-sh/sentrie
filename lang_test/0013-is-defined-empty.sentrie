namespace isops

derive blank = (v?: string): trinary => { yield v is empty }

policy defined_empty {
  fact user: document as user
  let lst = []
  let lst2 = [1, 2, 3]
  let m   = {"k": "v"}
  rule list_is_empty = { yield lst is empty }
  rule list_is_not_empty = { yield lst2 is not empty }
  rule map_is_defined = { yield m is defined }
  rule missing_is_not_defined = { yield user.missing is not defined }
  rule null_is_defined = { yield null is defined }
  rule null_is_empty = { yield null is empty }
  rule derive_is_empty = { yield blank("") }
  export decision of list_is_empty
  export decision of list_is_not_empty
  export decision of map_is_defined
  export decision of missing_is_not_defined
  export decision of null_is_defined
  export decision of null_is_empty
  export decision of derive_is_empty
}
