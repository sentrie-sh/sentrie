/* Sentrie Language Grammar - PEG Version */

/* Program Structure */
Program = (Comment)* NamespaceDecl (TopLevelDecl / Comment)*
TopLevelDecl = PolicyDecl / ShapeDecl / ExportShape / DeriveDecl / ExportDerive
NamespaceDecl = "namespace" FQN
/* A name's first segment is an identifier; a later segment may be a keyword (e.g. namespace constraints/in, text/string), since after "/" a keyword has no other meaning here. A slash-qualified name in an expression (a derive callee lib/in/double(2), the right of "is") is a division chain; there a keyword after "/" is also a segment, except the six that start an expression (not, true, false, unknown, null, transform), which keep that meaning: a/not b and a/true stay division. */
FQN = IDENT ("/" (IDENT / KEYWORD))*

/* Declarations */
PolicyDecl = "policy" IDENT "{" PolicyStatement* "}"
FactDecl = "fact" IDENT ("?")? ":" TypeRef ("as" IDENT)? ("default" Expr)?
/* "data" is contextual, not a reserved keyword: it starts a declaration only at the head of a policy statement. The IDENT names an entry of the pack manifest's [data] table. */
DataDecl = "data" IDENT (":" TypeRef)? ("as" IDENT)?

UseStmt = "use" "{" IDENT ("," IDENT)* "}" "from" ExecSource ("as" IDENT)?
ExecSource = STRING / ("@" ModulePathSegment ("/" ModulePathSegment)*)
/* A module path segment may be a keyword (e.g. @sentrie/string). Keywords are also accepted as a constraint name (ConstraintName), as a later segment of an FQN and as a FieldName. The default alias is the last segment, so a keyword last segment needs an explicit "as" IDENT. */
ModulePathSegment = IDENT / KEYWORD
/* A STRING source is a file path relative to the policy and must not start with "@": a quoted "@scope/name" is rejected with a hint to drop the quotes. */

PolicyStatement = Comment
                / ShapeDecl
                / FactDecl
                / DataDecl
                / UseStmt
                / VarDecl
                / RuleDecl
                / ContributeDecl
                / ExportRule
                / DeriveDecl

/* A shape can be exported from a namespace to allow visibility to other namespaces. 
   An unexported shape is visible to the containing namespace and its descendants only. */
ExportShape = "export" "shape" IDENT

DeriveDecl = "derive" IDENT "=" LambdaExpr
ExportDerive = "export" "derive" IDENT

VarDecl = "let" IDENT (":" TypeRef)? "=" Expr
RuleDecl = "rule" IDENT (":" TypeRef)? "=" ("default" Expr)? ("when" Expr)? (BlockExpr / RuleImportClause)
/* Adds to a rule declared earlier in the same policy with a list[T], boolean or trinary type. A list rule appends each contribution's value; a boolean rule ORs it in. Contributions combine in declaration order; one whose guard does not hold or whose body yields undefined is skipped. */
ContributeDecl = "contribute" IDENT ("when" Expr)? BlockExpr

/* Imports and Exports */
ExportRule = "export" "decision" "of" IDENT AttachClause*
AttachClause = "attach" FieldName "as" Expr

RuleImportClause = "import" "decision" IDENT "from" FQN WithClause*
WithClause = "with" IDENT "as" Expr

/* Expressions - ordered by precedence (highest to lowest) */
Expr = TernaryExpr
TernaryExpr = OrExpr ("?" ":" OrExpr / "?" Expr ":" Expr)?
OrExpr = XorExpr ("or" XorExpr)*
XorExpr = AndExpr ("xor" AndExpr)*
AndExpr = UnaryExpr ("and" UnaryExpr)*
UnaryExpr = ("not" / "!")? CmpExpr

/* Comparison Expressions */
CmpExpr = EqualityExpr
        / RelationalExpr
        / IsExpr
        / MatchesExpr
        / ContainsExpr
        / InExpr
        / KvInExpr
        / CountExpr
        / DefinedExpr
        / EmptyExpr
        / ListLiteral ListCmpOp AddExpr
        / MapLiteral MapCmpOp AddExpr
        / AddExpr CmpOp AddExpr
        / AddExpr

CmpOp = "==" / "!=" / "<=" / ">=" / "<" / ">" / "is" / "matches" / "contains"
ListCmpOp = "in" / "not" "in"
MapCmpOp = "in" / "not" "in"

/* Arithmetic Expressions - postfix `as TypeRef` binds tighter than + - * / in the Pratt parser.
   Repeated `as` allows chained casts (e.g. `x as T1 as T2`); the Pratt parser resolves them left-associatively. */
CastExpr = PrimaryExpr ("as" TypeRef)+
AddExpr  = MulExpr (( "+" / "-" ) MulExpr)*
MulExpr  = CastExpr (( "*" / "/" / "%" ) CastExpr)*

PrimaryExpr = Literal
            / IDENT
            / FunctionCall
            / IndexAccess
            / FieldAccess
            / LambdaExpr
            / GroupedExpr

LambdaExpr = "(" (IDENT ("," IDENT)*)? ")" "=>" BlockExpr

/* Specific Expression Types */
EqualityExpr = AddExpr ("==" / "!=") AddExpr
/* `<`, `<=`, `>`, `>=` order two numbers numerically and two strings by byte order (Go's strings.Compare),
   which is not locale-aware: "B" < "a". Any other pair of operands, including a string and a number, is an
   error; an undefined operand makes the result undefined. */
RelationalExpr = AddExpr ("<" / "<=" / ">" / ">=") AddExpr
/* `x is T` is true when x validates against the type T (false when it does not, or x is undefined).
   A right-hand side that starts with a type keyword is a TypeRef; a `?` that is followed by a token
   that can start an expression is the ternary operator, not a nullable suffix, except that '{' after a
   type keyword is a rule body ('when x is string? {'); after a name, '? {' stays a ternary. A bare or
   slash-qualified IDENT is a shape when it names one in scope (a name that is both a shape and a
   value is an error) and otherwise the legacy equality `x == y`; a `?` or `@` suffix or a `|` makes it
   a TypeRef. A bare `any` is always the top type here; compare with a value named `any` using `==`.
   Any other right-hand side is the legacy equality. */
IsExpr = AddExpr "is" ("not")? TypeRef
       / AddExpr "is" ("not")? AddExpr
       / AddExpr "is" "empty"
       / AddExpr "is" "not" "empty"
       / AddExpr "is" "defined"
       / AddExpr "is" "not" "defined"
MatchesExpr = AddExpr ("not")? "matches" AddExpr
ContainsExpr = AddExpr ("not")? "contains" AddExpr
InExpr = AddExpr ("not")? "in" AddExpr
KvInExpr = MapLiteral "in" AddExpr

/* Built-in collection helpers use ordinary calls, e.g. filter(list, (x) => { yield ... }). */
CountExpr = "count" AddExpr

/* State Checking */
DefinedExpr = AddExpr "is" ("not")? "defined"
EmptyExpr = AddExpr "is" ("not")? "empty"

/* Basic Expression Structures */
GroupedExpr = "(" Expr ")"
FunctionCall = IDENT ("." FieldName)? "(" CommaSeparatedExpr? ")"
CommaSeparatedExpr = Expr ("," Expr)*
IndexAccess = PrimaryExpr "[" Expr "]"
FieldAccess = PrimaryExpr "." FieldName
/* A field, shape element or attachment name may be a keyword (e.g. d.title, version: string, attach default as ...): in those positions a keyword has no other meaning. A bare map literal key may not. */
FieldName = IDENT / KEYWORD
BlockExpr = "{" (Comment / VarDecl / RuleDecl)* "yield" Expr "}"

/* Literals */
Literal = Scalar / ListLiteral / MapLiteral / "null"
Scalar = STRING / TRINARY / INT / FLOAT
ListLiteral = "[" (Expr ("," Expr)*)? "]"
MapLiteral = "{" (MapEntry ("," MapEntry)*)? "}"
MapEntry = STRING ":" Expr

/* Type System */
ShapeDecl = "shape" IDENT (TypeRef / ComplexShape)
/* A shape is closed: a value with a field it does not declare fails the check. A "..." marker as the
   last entry opens it; only comments may follow the marker. A field name may be declared once. A "with"
   base's openness is not inherited. */
ComplexShape = ("with" TypeName)? "{" ShapeElement* "..."? "}"
ShapeElement = FieldName ("?")? ":" TypeRef
/* A union matches when any member matches. `|` binds looser than a member's `?` and constraints and
   than brackets: `string | number?` is `string | (number?)`, and constraints bind to the member they
   follow. There is no grouping syntax. */
TypeRef = TypeRefMember ("|" TypeRefMember)*
TypeRefMember = (PrimitiveType / AnyType / TypeName / ListType / DictType / RecordType) ("?")? TypeRefConstraint*
/* `any` accepts every defined value, null included, and takes no constraints. It is not a keyword:
   a bare `any` in a type position is the top type, `any(...)` in an expression is the quantifier,
   and no shape may be named `any`. */
AnyType = "any"

TypeRefConstraint = "@" ConstraintName "(" CommaSeparatedExpr? ")"
/* A constraint name may be a keyword (e.g. @in). Right after "@" a keyword has no other meaning; a name that is not a constraint of the type is rejected as an unknown constraint. */
ConstraintName = IDENT / KEYWORD
PrimitiveType = "int" / "float" / "string" / "bool" / "document"
ListType = "list" "[" TypeRef "]"
DictType = "dict" "[" TypeRef "]"
RecordType = "record" "[" TypeRef ("," TypeRef)* "]"
TypeName = FQN

/* Basic Tokens */
IDENT = [a-zA-Z] [a-zA-Z0-9_]*
/* KEYWORD is any reserved word (the keywords map in tokens/token_kind.go, e.g. "string", "number", "policy"). Lexically it has the shape of an identifier, but the lexer emits it as a keyword token, so IDENT never matches one. */
KEYWORD = [a-zA-Z] [a-zA-Z0-9_]* /* restricted to the reserved words */
STRING = '"' (!["\\] . / "\\" .)* '"'
INT = [0-9]+
/* A literal with a fraction, an exponent, or both is a FLOAT. A malformed exponent ("1e", "1e+") or a bare decimal point before one ("1.e5") is a lexing error, not a number followed by an identifier. */
FLOAT = [0-9]+ ("." [0-9]+)? [eE] [+-]? [0-9]+ / [0-9]+ "." [0-9]+
TRINARY = "true" / "false" / "unknown"
Comment = "--" (!"\n" .)* "\n"

/* Character classes */
letter = [a-zA-Z]
digit = [0-9]
