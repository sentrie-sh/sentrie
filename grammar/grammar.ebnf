/* Sentrie Language Grammar */

/* Program Structure */
program             ::= (comment)* namespaceDecl ( toplevelDecl | comment )*
toplevelDecl        ::= policyDecl | shapeDecl | exportShape | deriveDecl | exportDerive
namespaceDecl       ::= 'namespace' FQN
FQN                 ::= IDENT ('/' IDENT)*

/* Declarations */
policyDecl          ::= 'policy' IDENT '{' ( policyStatement )* '}'
factDecl            ::= 'fact' IDENT ('?'?) ':' typeRef ('as' IDENT)? ('default' expr)?
/* 'data' is contextual, not a reserved keyword: it starts a declaration only at the head of a policy statement. The IDENT names an entry of the pack manifest's [data] table. */
dataDecl            ::= 'data' IDENT (':' typeRef)? ('as' IDENT)?


useStmt             ::= 'use' '{' IDENT ( ',' IDENT )* '}' 'from' execSource ('as' IDENT)?
execSource          ::= STRING | ('@' modulePathSegment ( '/' modulePathSegment )*)
/* A module path segment may be a keyword (e.g. @sentrie/string). This is the only position where a keyword is accepted as a name; the default alias is the last segment, so a keyword last segment needs an explicit 'as IDENT'. */
modulePathSegment   ::= IDENT | KEYWORD
/* A STRING source is a file path relative to the policy and must not start with '@': a quoted "@scope/name" is rejected with a hint to drop the quotes. */

policyStatement     ::= comment
                        | shapeDecl
                        | factDecl
                        | dataDecl
                        | useStmt
                        | varDecl
                        | ruleDecl
                        | exportRule
                        | deriveDecl

/* A shape can be exported from a namespace to allow visiblity to other namespaces. An unexported shape is visible to the containing namespace and it's descendants only. */
exportShape         ::= 'export' 'shape' IDENT

deriveDecl          ::= 'derive' IDENT '=' lambdaExpr
exportDerive        ::= 'export' 'derive' IDENT

varDecl             ::= 'let' IDENT '=' expr
ruleDecl            ::= 'rule' IDENT '=' ('default' expr)? ('when' expr)? (blockExpr | ruleImportClause)

/* Imports and Exports */
exportRule          ::= 'export' 'decision' 'of' IDENT ( attachClause )*
attachClause        ::= 'attach' IDENT 'as' expr

ruleImportClause    ::= 'import' 'decision' IDENT 'from' FQN ( withClause )*
withClause          ::= 'with' IDENT 'as' expr

/* Expressions */
expr                ::= ternaryExpr
ternaryExpr         ::= orExpr ( '?' ':' orExpr | '?' expr ':' expr )?
orExpr              ::= xorExpr ( 'or'  xorExpr )*
xorExpr             ::= andExpr ( 'xor' andExpr )*
andExpr             ::= unaryExpr ( 'and' unaryExpr )*
unaryExpr           ::= ( 'not' | '!' )? cmpExpr

/* Comparison Expressions */
cmpExpr             ::= addExpr
                      | addExpr cmpOp addExpr
                      | listLiteral listCmpOp addExpr
                      | mapLiteral mapCmpOp addExpr
                      | equalityExpr
                      | relationalExpr
                      | isExpr
                      | matchesExpr
                      | containsExpr
                      | inExpr
                      | kvInExpr
                      | countExpr
                      | definedExpr
                      | emptyExpr

cmpOp               ::= '==' | '!=' | '<=' | '>=' | '<' | '>' | 'is' | 'matches' | 'contains'
listCmpOp           ::= 'in' | 'not in'
mapCmpOp            ::= 'in' | 'not in'

/* Arithmetic Expressions - postfix `as typeRef` binds tighter than + - * / in the Pratt parser.
   One-or-more repeats allow chained casts (e.g. `x as T1 as T2`); the Pratt parser resolves them left-associatively. */
castExpr            ::= primaryExpr ( 'as' typeRef )+
mulExpr             ::= castExpr ( ( '*' | '/' | '%' ) castExpr )*
addExpr             ::= mulExpr ( ( '+' | '-' ) mulExpr )*

primaryExpr         ::= literal
                      | IDENT
                      | functionCall
                      | indexAccess
                      | fieldAccess
                      | lambdaExpr
                      | groupedExpr

lambdaExpr          ::= '(' ( IDENT ( ',' IDENT )* )? ')' '=>' blockExpr

/* Specific Expression Types */
equalityExpr        ::= addExpr ( '==' | '!=' ) addExpr
relationalExpr      ::= addExpr ( '<' | '<=' | '>' | '>=' ) addExpr
/* `x is T` is true when x validates against the type T (false when it does not, or x is undefined).
   A right-hand side that starts with a type keyword is a typeRef; a '?' that is followed by a token
   that can start an expression is the ternary operator, not a nullable suffix, except that '{' after a
   type keyword is a rule body ('when x is string? {'); after a name, '? {' stays a ternary. A bare or
   slash-qualified IDENT is a shape when it names one in scope (a name that is both a shape and a
   value is an error) and otherwise the legacy equality `x == y`; a '?' or '@' suffix makes it a typeRef.
   Any other right-hand side is the legacy equality. */
isExpr              ::= addExpr 'is' 'not'? typeRef
                      | addExpr 'is' 'not'? addExpr
                      | addExpr 'is' 'empty'
                      | addExpr 'is' 'not' 'empty'
                      | addExpr 'is' 'defined'
                      | addExpr 'is' 'not' 'defined'
matchesExpr         ::= addExpr ( 'not' )? 'matches' addExpr
containsExpr        ::= addExpr ( 'not' )? 'contains' addExpr
inExpr              ::= addExpr ( 'not' )? 'in' addExpr
kvInExpr            ::= mapLiteral 'in' addExpr

/* Built-in collection helpers are ordinary function calls, e.g. filter(list, (x) => { yield ... }). */
countExpr           ::= 'count' addExpr

/* State Checking */
definedExpr         ::= addExpr 'is' 'not'? 'defined'
emptyExpr           ::= addExpr 'is' 'not'? 'empty'

/* Basic Expression Structures */
groupedExpr         ::= '(' expr ')'
functionCall        ::= IDENT ('.' IDENT)? '(' commaSeparatedExpr? ')'
commaSeparatedExpr  ::= expr (',' expr)*
indexAccess         ::= primaryExpr '[' expr ']'
fieldAccess         ::= primaryExpr '.' IDENT
blockExpr           ::= '{' ( comment | varDecl | ruleDecl )* 'yield' expr '}'

/* Literals */
literal             ::= scalar | listLiteral | mapLiteral | 'null'
scalar              ::= STRING | TRINARY | INT | FLOAT
listLiteral         ::= '[' ( expr ( ',' expr )* )? ']'
mapLiteral          ::= '{' ( mapEntry ( ',' mapEntry )* )? '}'
mapEntry            ::= STRING ':' expr

/* Type System */
shapeDecl           ::= 'shape' IDENT ( typeRef | complexShape )
complexShape        ::= ('with' typeName)? '{' shapeElement+ '}'
shapeElement        ::= IDENT ('?')? ":" typeRef
typeRef             ::= (primitiveType
                          | typeName
                          | recordType
                          | listType
                          | dictType) ('?')? typeRefConstraint*

typeRefConstraint ::= '@' IDENT '(' commaSeparatedExpr? ')'
primitiveType       ::= 'int' | 'float' | 'string' | 'bool' | 'document'
listType            ::= 'list' '[' typeRef ']'
dictType            ::= 'dict' '[' typeRef ']'
recordType          ::= 'record' '[' typeRef (',' typeRef)* ']'
typeName            ::= FQN

/* Basic Tokens */
IDENT               ::= letter ( letter | digit | '_' )*
/* KEYWORD is any reserved word (the keywords map in tokens/token_kind.go, e.g. 'string', 'number', 'policy'). Lexically it has the shape of an identifier, but the lexer emits it as a keyword token, so IDENT never matches one. */
KEYWORD             ::= letter ( letter | digit | '_' )* /* restricted to the reserved words */
STRING              ::= '"' ( /* any char except '"' or '\' or escaped */ )* '"'
INT                 ::= digit+
FLOAT               ::= digit+ '.' digit+
TRINARY             ::= 'true' | 'false' | 'unknown'
letter              ::= 'a'..'z' | 'A'..'Z'
digit               ::= '0'..'9'
comment             ::= '--' /* any char except newline */* '\n'
